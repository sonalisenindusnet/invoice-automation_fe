# Copy this to .env (or .env.local for a personal override) and adjust as
# needed. Create React App only reads these at build/start time — restart
# `npm start` after changing them.

# Base URL for the "save invoice request" API called by src/api/invoiceApi.js
REACT_APP_SAVE_INVOICE_API_URL=http://localhost:5000/invoice/api/v1/invoice-generation

# MIS "project info" lookup, called by src/api/misApi.js when the "Fetch
# project details" checkbox next to PF Id is ticked.
# SECURITY: REACT_APP_* values are baked into the built JS bundle and
# visible to anyone using the app — this is NOT a safe place for a real
# secret in production. Fine for local/internal testing; route this call
# through your own backend before shipping publicly. Put your REAL key in
# your own local .env (gitignored) — never commit a real key here.
REACT_APP_MIS_API_URL=http://13.235.37.117:8161/api/projectinfo
REACT_APP_MIS_API_KEY=replace-with-your-real-key
